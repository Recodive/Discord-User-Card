{
	"name": "@discord-user-card/monorepo",
	"type": "module",
	"version": "0.0.9",
	"private": true,
	"packageManager": "pnpm@9.6.0",
	"description": "Monorepo containing the Discord-User-Card's codebase",
	"license": "MPL-2.0",
	"engines": {
		"node": "^24.22.1"
	},
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"build": "pnpm -r build",
		"dev": "pnpm -r dev",
		"test": "vitest --run",
		"test:ui": "vitest --ui",
		"release": "pnpm i && pnpm -r build && bumpp package.json packages/*/package.json --commit --push --tag"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^2.24.1",
		"@commitlint/cli": "^19.3.0",
		"@recodive/configs": "^1.8.4",
		"@types/node": "^22.0.3",
		"@vitest/ui": "^2.1.9",
		"bumpp": "^9.4.2",
		"eslint": "^9.8.0",
		"happy-dom": "^14.12.3",
		"playwright": "^1.64.1",
		"typescript": "^5.5.4",
		"vitest": "^4.0.0"
	},
	"pnpm": {
		"overrides": {
			"@vue/server-renderer@>=3.0.0 <4.0.0": "^3.5.42",
			"brace-expansion@>=1.0.0 <2.0.0": "^1.1.20",
			"brace-expansion@>=2.0.0 <3.0.0": "^2.1.6",
			"browserslist@>=4.0.0 <5.0.0": "^4.28.7",
